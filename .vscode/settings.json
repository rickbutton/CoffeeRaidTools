{
    "files.eol": "\n",
    "wowAPI.luals.frameXML": false,
    "wowAPI.luals.configurationScope": "User",
    "Lua.workspace.ignoreDir": [".vscode"],
    "Lua.runtime.special": {
        "relImport": "require"
    },
    "Lua.diagnostics.globals": [
        "StaticPopup_Visible",
        "StaticPopup_Hide",
        "StaticPopup_Show",
        "UISpecialFrames",
        "RAID_CLASS_COLORS",
        "GameFontNormalLarge",
        "GameFontHighlightSmall",
        "GameFontNormalSmall",
        "GameFontNormal",
        "LE_PARTY_CATEGORY_INSTANCE",
        "GameTooltip",
        "ACCEPT",
        "CANCEL"
    ],
    "Lua.diagnostics.disable": [
        "ambiguity-1",
        "cast-local-type",
        "deprecated",
        "duplicate-set-field",
        "inject-field",
        "lowercase-global",
        "missing-fields",
        "missing-parameter",
        "missing-return",
        "need-check-nil",
        "param-type-mismatch",
        "redundant-parameter",
        "unbalanced-assignments",
        "undefined-field",
        "undefined-global"
    ]
}
